        get :my_membership do
          authenticate!
          require_tenant!

          membership = current_user.tenant_memberships
                                  .find_by(tenant_id: current_tenant.id, status: "active")

          unless membership
            error_response(
              message: "Membership not found",
              status: 404
            )
          end

          present membership,
                  with: Entities::TenantMembershipEntity,
                  include_tenant: false,
                  include_user: false,
                  show_timestamps: true
        end

        # ============================================
        # USUARIOS DEL TENANT
        # ============================================
        desc "List users in current tenant",
              tags: [ "Tenant" ],
              success: { code: 200 },
              failure: [
                { code: 401, message: "Authentication required" },
                { code: 403, message: "Permission denied" }
              ]
        params do
          optional :status, type: String, values: TenantMembership::STATUSES
          optional :role_slug, type: String, values: -> { TenantMembership.available_role_slugs }
          optional :page, type: Integer, default: 1
          optional :per_page, type: Integer, default: 25, values: 1..100
        end
        get :users do
          authenticate!
          require_tenant!
          require_tenant_admin_or_manager!

          # Obtener membresías del tenant
          memberships = current_tenant.tenant_memberships.kept.includes(:role, :user)

          # Filtros
          memberships = memberships.where(status: params[:status]) if params[:status]

          # Filtrar por role_slug si se proporciona
          if params[:role_slug]
            role = Role.tenant_roles.find_by(slug: params[:role_slug])
            memberships = memberships.where(role_id: role.id) if role
          end

          # Paginación
          memberships = memberships.page(params[:page]).per(params[:per_page])

          # Retornar con metadata de paginación
          success_response(
            data: memberships.map { |m|
              Entities::TenantMembershipEntity.represent(
                m,
                include_user: true,
                include_tenant: false
              )
            },
            meta: {
              current_page: memberships.current_page,
              total_pages: memberships.total_pages,
              total_count: memberships.total_count,
              per_page: params[:per_page]
            }
          )
        end

        # ============================================
        # INVITAR USUARIO
        # ============================================
        desc "Invite user to tenant",
              tags: [ "Tenant" ],
              success: { code: 201 },
              failure: [
                { code: 401, message: "Authentication required" },
                { code: 403, message: "Permission denied" },
                { code: 422, message: "Validation error" }
              ]
        params do
          requires :email, type: String, desc: "User email"
          requires :first_name, type: String, desc: "First name"
          requires :last_name, type: String, desc: "Last name"
          requires :role_slug, type: String, values: -> { TenantMembership.available_role_slugs }, desc: "Role slug (e.g., tenant_admin, tenant_manager, tenant_driver)"
          optional :phone, type: String, desc: "Phone number"
        end
        post :invite do
          authenticate!
          require_tenant!
          require_tenant_admin_or_manager!

          result = Platform::Tenants::InviteService.call(
            tenant: current_tenant,
            params: declared(params),
            invited_by: current_user
          )

          if result.success?
            status 201
            success_response(
              data: {
                user: Entities::UserEntity.represent(result.data[:user]),
                membership: Entities::TenantMembershipEntity.represent(
                  result.data[:membership],
                  include_user: false,
                  include_tenant: false
                ),
                invitation_token: result.data[:invitation_token]
              },
              message: result.message
            )
          else
            error_response(
              message: result.message,
              errors: result.errors,
              status: 422
            )
          end
        end

        # ============================================
        # ESTADÍSTICAS DEL TENANT
        # ============================================
        desc "Get tenant statistics",
              tags: [ "Tenant" ],
              success: { code: 200 },
              failure: [
                { code: 401, message: "Authentication required" },
                { code: 403, message: "Permission denied" }
              ]
        get :stats do
          authenticate!
          require_tenant!
          require_tenant_admin!

          stats = {
            users: {
              total: current_tenant.tenant_memberships.count,
              active: current_tenant.active_memberships.count,
              invited: current_tenant.tenant_memberships.invited.count,
              suspended: current_tenant.tenant_memberships.suspended.count
            },
            roles: {
              admins: current_tenant.tenant_memberships.with_role_slug("tenant_admin").count,
              managers: current_tenant.tenant_memberships.with_role_slug("tenant_manager").count,
              drivers: current_tenant.tenant_memberships.with_role_slug("tenant_driver").count
            },
            limits: {
              max_users: current_tenant.max_users,
              current_users: current_tenant.active_users.count,
              remaining_slots: current_tenant.remaining_user_slots,
              limit_reached: current_tenant.user_limit_reached?
            },
            subscription: {
              status: current_tenant.status,
              plan: current_tenant.plan,
              trial_days_remaining: current_tenant.trial? ? current_tenant.trial_days_remaining : nil
            }
          }

          success_response(data: stats)
        end
      end
    end
  end
end

