      with_options(if: ->(user, opts) { opts[:type] == :summary }) do
        expose :id
        expose :email
        expose :full_name
        expose :avatar_url
      end

      # Detalles completos
      # Uso: present user, with: UserEntity, type: :detailed
      with_options(if: ->(user, opts) { opts[:type] == :detailed }) do
