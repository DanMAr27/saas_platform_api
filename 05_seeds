    node.state = "Catalonia"
    node.country = "ES"
  end

  puts "    ✓ 6 Branches created"

  # NIVEL 4: Departamentos (opcional, solo en algunas sucursales)
  dept_sales_bcn = OrganizationalNode.find_or_create_by!(
    tenant: tenant,
    level: department_level,
    parent: branch_bcn,
    code: "BCN-SALES"
  ) do |node|
    node.name = "Sales Department"
    node.description = "Barcelona sales team"
    node.status = "active"
  end

  dept_logistics_bcn = OrganizationalNode.find_or_create_by!(
    tenant: tenant,
    level: department_level,
    parent: branch_bcn,
    code: "BCN-LOG"
  ) do |node|
    node.name = "Logistics Department"
    node.description = "Barcelona logistics and distribution"
    node.status = "active"
  end

  dept_support_bcn = OrganizationalNode.find_or_create_by!(
    tenant: tenant,
    level: department_level,
    parent: branch_bcn,
    code: "BCN-SUP"
  ) do |node|
    node.name = "Customer Support"
    node.description = "Barcelona customer support center"
    node.status = "active"
  end

  puts "    ✓ 3 Departments created (Barcelona branch)"

  # ============================================
  # VERIFICAR CLOSURE TABLE
  # ============================================
  puts "  Verifying closure table integrity..."

  total_nodes = OrganizationalNode.count
  total_closures = OrganizationalNodeClosure.count

  puts "    - Total nodes: #{total_nodes}"
  puts "    - Total closure records: #{total_closures}"

  # Verificar que cada nodo tiene self-reference
  self_refs = OrganizationalNodeClosure.where("ancestor_id = descendant_id").count
  puts "    - Self-references: #{self_refs}"

  if self_refs == total_nodes
    puts "    ✓ Closure table integrity OK"
  else
    puts "    ⚠️  Closure table might have issues"
  end

  # ============================================
  # ESTADÍSTICAS
  # ============================================
  puts "\n  📊 Organizational Structure Summary:"
  puts "    - Levels: #{OrganizationalNodeLevel.count}"
  puts "    - Total Nodes: #{total_nodes}"
  puts "    - Root Nodes: #{OrganizationalNode.roots.count}"
  puts "    - Leaf Nodes: #{OrganizationalNode.all.select(&:leaf?).count}"
  puts "    - Max Depth: #{OrganizationalNode.maximum('(SELECT MAX(depth) FROM organizational_node_closures WHERE descendant_id = organizational_nodes.id)') || 0}"

  puts "\n  📍 Nodes by Level:"
  OrganizationalNodeLevel.by_order.each do |level|
    count = level.organizational_nodes.count
    puts "    - #{level.name}: #{count} nodes"
  end

  puts "\n  🌳 Sample Tree Structure:"
  company.direct_children.each do |region|
    puts "    #{company.name}"
    puts "    └─ #{region.name}"
    region.direct_children.each do |branch|
      puts "       └─ #{branch.name}"
      branch.direct_children.each do |dept|
        puts "          └─ #{dept.name}"
      end
    end
  end
end

