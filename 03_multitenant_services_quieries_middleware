# Middleware para establecer el contexto de tenant en cada request
# Lee el tenant_id del JWT y lo establece en ActsAsTenant.current_tenant
# Esto asegura que todas las queries estén scoped al tenant correcto

class TenantContext
  def initialize(app)
    @app = app
  end

  def call(env)
    # Obtener tenant_id del token JWT
    tenant_id = extract_tenant_id_from_token(env)

    if tenant_id.present?
      # Buscar tenant
      tenant = Tenant.find_by(id: tenant_id)

      if tenant&.active?
        # Establecer contexto de tenant para este request
        ActsAsTenant.with_tenant(tenant) do
          @app.call(env)
        end
      else
        # Tenant no encontrado o inactivo
        error_response(
          "Invalid or inactive tenant",
          401,
          env
        )
      end
    else
      # Sin tenant_id (puede ser usuario de plataforma o endpoint público)
      # Ejecutar sin tenant context
      ActsAsTenant.without_tenant do
        @app.call(env)
      end
    end
  rescue ActsAsTenant::Errors::NoTenantSet => e
    Rails.logger.error("[TenantContext] No tenant set: #{e.message}")
    error_response("Tenant context required", 400, env)
  rescue StandardError => e
    Rails.logger.error("[TenantContext] Error: #{e.class.name} - #{e.message}")
    error_response("Tenant context error", 500, env)
  end

  private

  # Extraer tenant_id del token JWT
  def extract_tenant_id_from_token(env)
    # Obtener header de autorización
    auth_header = env["HTTP_AUTHORIZATION"]
    return nil unless auth_header

    # Extraer token
    match = auth_header.match(/^Bearer\s+(.+)$/i)
    return nil unless match

    token = match[1]

    # Decodificar token sin validación completa (solo peek)
    payload = Authentication::JwtDecoder.peek(token)
    return nil unless payload

    # Retornar tenant_id del payload
    payload = Authentication::JwtDecoder.peek(token)&.deep_symbolize_keys
    payload[:tenant_id]
  rescue StandardError => e
    Rails.logger.debug("[TenantContext] Failed to extract tenant_id: #{e.message}")
    nil
  end

  # Respuesta de error
  def error_response(message, status, env)
    body = {
      success: false,
      error: {
        message: message,
        status: status,
        timestamp: Time.current.iso8601
      }
    }.to_json

    headers = {
      "Content-Type" => "application/json",
      "Content-Length" => body.bytesize.to_s
    }

    [ status, headers, [ body ] ]
  end
end
